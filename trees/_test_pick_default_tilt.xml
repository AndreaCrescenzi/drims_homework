<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    Diagnostic-only spike: pick-only preview (no gripper close, no
    attach, no rotation), tilt_deg left unset so GetGraspOrientation
    auto-derives the default ~45 deg tilted approach -- the twin of
    _test_pick_no_tilt.xml, used to bisect the workspace edge and find
    where the 45 deg tilted pick starts failing vs. where a vertical
    (tilt=0) pick still succeeds.
    -->
    <BehaviorTree ID="MainTree">
        <Sequence>
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <GetFaceRotation current_face="{face}" target_face="4" orientation="{rel_quat}" ref_frame="{ref_frame}"/>
            <GetGraspOrientation current_face="{face}" target_face="4" rotation_quat="{rel_quat}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
        </Sequence>
    </BehaviorTree>
</root>

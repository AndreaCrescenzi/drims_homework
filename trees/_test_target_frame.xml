<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    Diagnostic/dev tree: verifies ComputeXYCorrection's new optional
    "target_frame" port. Identifies the die (for a valid current_pose
    input, required by the node), then asks ComputeXYCorrection for the
    correction needed to bring it to (0.365, 0.265) in "camera_frame_floor"
    (the floor plate's own local center -- frame_x=0.73, frame_y=0.53 in
    ur5e_cell.urdf.xacro's camera_frame instantiation) instead of
    base_link. No motion is commanded -- this only exercises the TF math
    and prints the equivalent base_link coordinates via the node's own
    RCLCPP_INFO logging, to sanity-check the conversion before trusting it
    for a real placement target.
    -->
    <BehaviorTree ID="MainTree">
        <Sequence>
            <DiceIdentification service_name="/dice_identification" face_number="{face1}" pose="{dice_pose1}"/>
            <ComputeXYCorrection current_pose="{dice_pose1}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" target_z="0.0" xy_correction="{xy_corr}"/>
        </Sequence>
    </BehaviorTree>
</root>

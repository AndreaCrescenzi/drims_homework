<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    Diagnostic-only spike: exercises every motion primitive (MoveToJoint x2,
    MoveToPose absolute, MoveToPose relative cartesian translation, MoveToPose
    relative cartesian rotation, MoveToPose relative joint-space,
    GripperCommand close/open) back-to-back in a loop, all relative to
    tool0/base_link -- no dice TF dependency at all, so any wedge here is
    isolated to the motion stack (motion_server/pymoveit2), not dice logic.
    Every step is wrapped in Fallback+AlwaysSuccess so a single planning
    failure (e.g. transient NO_IK_SOLUTION) doesn't stop the loop early --
    we only care about hangs (SEND_GOAL_TIMEOUT / never-returning calls)
    here, visible as timestamp gaps in the log, not about whether any one
    move succeeds.
    -->
    <BehaviorTree ID="MainTree">
        <Repeat num_cycles="30">
            <Sequence>
                <Fallback>
                    <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
                    <AlwaysSuccess/>
                </Fallback>
                <Fallback>
                    <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.57;1.57;-1.57;-1.57;0.0"/>
                    <AlwaysSuccess/>
                </Fallback>
                <Fallback>
                    <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="base_link" position="0.6;0.1;0.95" orientation="1.0;0.0;0.0;0.0"/>
                    <AlwaysSuccess/>
                </Fallback>
                <Fallback>
                    <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="tool0" position="0.0;0.0;0.05" orientation="0.0;0.0;0.0;1.0"/>
                    <AlwaysSuccess/>
                </Fallback>
                <Fallback>
                    <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="tool0" position="0.0;0.0;0.0" orientation="0.0;0.0;0.259;0.966"/>
                    <AlwaysSuccess/>
                </Fallback>
                <Fallback>
                    <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" velocity_scaling="0.4" frame_id="tool0" position="0.0;0.0;-0.05" orientation="0.0;0.0;-0.259;0.966"/>
                    <AlwaysSuccess/>
                </Fallback>
                <Fallback>
                    <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
                    <AlwaysSuccess/>
                </Fallback>
                <Fallback>
                    <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                    <AlwaysSuccess/>
                </Fallback>
            </Sequence>
        </Repeat>
    </BehaviorTree>
</root>

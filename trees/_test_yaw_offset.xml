<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    Diagnostic-only spike: pick-only preview (no gripper close, no
    attach, no rotation) for a given current->target pair, with an extra
    yaw_offset_deg on top of the normal grasp yaw/tilt selection. Used to
    visually verify on RViz whether a 90deg yaw offset clears a finger
    off the target face when tilt would otherwise put it there (observed
    for 3->2).
    -->
    <BehaviorTree ID="MainTree">
        <Sequence>
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <GetFaceRotation current_face="{face}" target_face="2" orientation="{rel_quat}" ref_frame="{ref_frame}"/>
            <GetGraspOrientation current_face="{face}" target_face="2" rotation_quat="{rel_quat}" yaw_offset_deg="90.0" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
        </Sequence>
    </BehaviorTree>
</root>

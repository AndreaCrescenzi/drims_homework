<root BTCPP_format="4">
    <BehaviorTree ID="MainTree">
        <Sequence>
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <GetGraspOrientation current_face="{face}" target_face="4" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
            <AttachObject service_name="/attach_object" object_id="dice" target_frame_id="tool0"/>
            <GetFaceRotation current_face="{face}" target_face="4" orientation="{rel_quat}" ref_frame="{ref_frame}"/>
            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="{ref_frame}" position="0.0;0.0;0.18" orientation="0.0;0.0;0.0;1.0"/>
            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="{ref_frame}" position="0.0;0.0;0.0" orientation="{rel_quat}"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
            <ComputeXYCorrection current_pose="{dice_pose2}" target_x="0.6" target_y="0.1" xy_correction="{xy_corr}"/>
            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="{xy_corr}" orientation="0.0;0.0;0.0;1.0"/>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
            <DetachObject service_name="/detach_object" object_id="dice"/>
        </Sequence>
    </BehaviorTree>
</root>

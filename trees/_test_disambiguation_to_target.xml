<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    Diagnostic/dev tree: full pipeline demo. Disambiguates a 90deg-pip-
    symmetric starting face (1, 4, or 5) via the validated tip-and-relook
    technique (_test_disambiguation.xml), then hands off to the EXISTING,
    unmodified ReorientCycle (copied verbatim from dice_challenge.xml) to
    rotate the die to a real target face -- proving the two pieces work
    together end to end, not just the disambiguation step in isolation.

    ReorientCycle itself needs no orientation information at all (just
    current_face, via its own TF lookup on face{N}_tf) -- see its own
    comment -- so once the disambiguation phase leaves the die resting in
    a known state, handing off is just: re-identify (a plain, non-
    ambiguous-aware read) to get the die's actual current face, then call
    ReorientCycle like any other caller in dice_challenge.xml.
    -->

    <!-- ReorientCycle: copied verbatim from dice_challenge.xml, not
         modified in any way for this test. -->
    <BehaviorTree ID="ReorientCycle">
        <Sequence>
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <GetFaceRotation current_face="{face}" target_face="{target}" orientation="{rel_quat}" ref_frame="{ref_frame}"/>
            <GetGraspOrientation current_face="{face}" target_face="{target}" rotation_quat="{rel_quat}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
            </RetryUntilSuccessful>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
            <AttachObject service_name="/attach_object" object_id="dice" target_frame_id="tool0"/>
            <ComputeXYCorrection current_pose="{dice_pose}" target_x="0.55" target_y="0.1" z_offset="0.07" xy_correction="{xy_corr_pre}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_pre}" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="{ref_frame}" position="0.0;0.0;0.0" orientation="{rel_quat}"/>
            </RetryUntilSuccessful>
            <Fallback>
                <Precondition if="skip_placement == 'true'" else="FAILURE">
                    <Sequence>
                        <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
                        <ComputeXYCorrection current_pose="{dice_pose2}" target_x="0.55" target_y="0.1" xy_correction="{xy_corr_mid_xy}"/>
                        <RetryUntilSuccessful num_attempts="2">
                            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_mid_xy}" orientation="0.0;0.0;0.0;1.0"/>
                        </RetryUntilSuccessful>
                        <DiceIdentification service_name="/dice_identification" face_number="{face2b}" pose="{dice_pose2b}"/>
                        <ComputeXYCorrection current_pose="{dice_pose2b}" target_x="0.55" target_y="0.1" target_z="0.027" xy_correction="{xy_corr_mid_z}"/>
                        <RetryUntilSuccessful num_attempts="2">
                            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_mid_z}" orientation="0.0;0.0;0.0;1.0"/>
                        </RetryUntilSuccessful>
                        <Fallback>
                            <DetachObject service_name="/detach_object" object_id="dice"/>
                            <AlwaysSuccess/>
                        </Fallback>
                        <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                    </Sequence>
                </Precondition>
                <Sequence>
                    <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
                    <ComputeXYCorrection current_pose="{dice_pose2}" target_x="0.55" target_y="0.1" target_z="0.027" xy_correction="{xy_corr}"/>
                    <RetryUntilSuccessful num_attempts="2">
                        <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr}" orientation="0.0;0.0;0.0;1.0"/>
                    </RetryUntilSuccessful>
                    <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                    <DetachObject service_name="/detach_object" object_id="dice"/>
                </Sequence>
            </Fallback>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="MainTree">
        <Sequence>
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face1}" pose="{dice_pose1}"/>

            <!-- ===== Disambiguation phase (validated in
                 _test_disambiguation.xml, unchanged) ===== -->
            <GetGraspOrientation current_face="{face1}" target_face="{face1}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
            </RetryUntilSuccessful>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
            <AttachObject service_name="/attach_object" object_id="dice" target_frame_id="tool0"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="0.0;0.0;0.10" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="0.0;0.0;0.0" orientation="0.0;0.7071067811865476;0.0;0.7071067811865476"/>
            </RetryUntilSuccessful>
            <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
            <ResolveAmbiguousFace ambiguous_face="{face1}" second_face="{face2}" resolved_theta_deg="{theta}"/>
            <!-- Release-safety fix: always undo the exact tip rotation
                 (same fixed world_Y axis, opposite angle) instead of
                 detecting+correcting verticality per case. This returns
                 the gripper unconditionally to {pick_orientation} -- the
                 same reachable, non-vertical pose it picked from --
                 regardless of face1/face2/theta. See _test_disambiguation.xml
                 for the full rationale (a boolean-driven single-sign
                 correction cannot work: it discards which of the two
                 distinct bad configurations occurred). -->
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="0.0;0.0;0.0" orientation="0.0;-0.7071067811865476;0.0;0.7071067811865476"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="0.0;0.0;-0.10" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>

            <!-- ===== Hand-off to the standard technique: ReorientCycle
                 does its own fresh identification internally (its first
                 real step, {face} is entirely local to it -- it's not an
                 input port, see dice_challenge.xml), so it needs nothing
                 special passed in. This extra read here is only for log
                 visibility, to see what face the disambiguation sequence
                 actually left the die resting on (not necessarily face1
                 or face2) before ReorientCycle re-reads it itself.
                 Target hardcoded to 6 for this demo -- any face other
                 than whatever face1 was, just so the rotation is real
                 and visible. ===== -->
            <DiceIdentification service_name="/dice_identification" face_number="{face3}" pose="{dice_pose3}"/>
            <SubTree ID="ReorientCycle" target="6" skip_placement="false"/>

            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
        </Sequence>
    </BehaviorTree>
</root>

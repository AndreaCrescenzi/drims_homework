<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    Diagnostic/dev tree: proves out the tip-and-relook disambiguation for
    the 90deg-pip-symmetric faces (1, 4, 5). Spawn the die showing one of
    those faces, run this, and check the printed resolved_theta_deg
    against the ResolveAmbiguousFace lookup table (derived and verified
    numerically -- see resolve_ambiguous_face.hpp's comment) for the
    (ambiguous_face, second_face) pair logged by bt_executor_node.

    Uses the REAL /dice_identification (ground truth in sim) for both
    reads -- deliberately, not /dice_identification_noisy: the algorithm
    itself only ever looks at face_number (pip count, always reliable
    even for a real camera), never at any reported orientation, so there
    is nothing to "cheat" by reading ground truth here. This tree proves
    the ALGORITHM (the tip motion + lookup table); testing it against
    /dice_identification_noisy's interface is a separate, later check
    that the wiring degrades gracefully to a service that only offers a
    noisy orientation.

    Tip motion: 90deg about the WORLD-frame Y axis (quaternion
    0.0;0.7071;0.0;0.7071), commanded via relative_motion=true in
    base_link -- base_link and world share the same orientation in this
    cell (only the origin differs, a pure translation -- confirmed
    empirically all session), so a base_link-relative delta here is a
    true world-frame (extrinsic) rotation. Deliberately NOT about the
    grasp's own closing axis: that was tried first and shown (by the
    same verification script) to be information-theoretically useless,
    since it co-rotates with the very yaw ambiguity being resolved.
    world_X was also tried and is equally valid on paper, but hit
    NO_IK_SOLUTION from this specific wrist configuration -- world_Y
    works.
    -->
    <BehaviorTree ID="MainTree">
        <Sequence>
            <!-- Defensive release: a previous run of this dev tree can be
                 interrupted mid-cycle (this happened once already, a
                 Cartesian-planning failure on the tip move left the die
                 attached mid-air), same pattern as dice_challenge.xml's
                 ReorientCycle. -->
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face1}" pose="{dice_pose1}"/>
            <!-- Tilted pick (default auto-derived tilt, -45deg since no
                 rotation_quat info is given for this degenerate
                 target_face==current_face call) -- testing whether the
                 standard production grasp (used everywhere else in
                 dice_challenge.xml) behaves differently through the
                 tip-and-relook sequence than the vertical pick just
                 tried. -->
            <GetGraspOrientation current_face="{face1}" target_face="{face1}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
            </RetryUntilSuccessful>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
            <AttachObject service_name="/attach_object" object_id="dice" target_frame_id="tool0"/>
            <!-- Lift for clearance before tipping -- same reasoning as
                 dice_challenge.xml: lift+rotate combined in one straight-
                 line move can run out of reachable configurations: kept
                 as two separate moves. -->
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="0.0;0.0;0.10" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <!-- The tip: 90deg about world Y, fixed regardless of face/yaw
                 (world_X was tried first: NO_IK_SOLUTION from this wrist
                 configuration -- a real reachability limit, not a
                 planning artifact, retried twice at ~24s each. The
                 derivation showed world_X/world_Y/either sign are all
                 equally valid information-theoretically, so switching
                 axis is a legitimate fix, same as picking a different
                 tilt sign elsewhere in this project when one direction
                 turned out unreachable). cartesian_motion=false (joint-
                 space planning): a 90deg reorientation is too large to
                 reliably complete as a straight-line Cartesian
                 interpolation (observed directly: "Cartesian planner
                 completed 0.69 of the trajectory, less than the
                 threshold 0.99" on the very first attempt with
                 cartesian_motion=true). -->
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="0.0;0.0;0.0" orientation="0.0;0.7071067811865476;0.0;0.7071067811865476"/>
            </RetryUntilSuccessful>
            <!-- Resolve theta right after the tip, BEFORE any release-
                 safety correction below -- still reading the REAL
                 ground-truth /dice_identification (correct regardless of
                 finger placement in THIS simulated setup), so the
                 resolve_ambiguous_face.hpp lookup table (derived for the
                 face reached immediately after the tip) stays valid
                 unchanged. A real camera would need the "infer from
                 kinematics when occluded" logic noted in
                 check_closing_axis_vertical.hpp's comment instead --
                 deliberately not built yet, out of scope for proving the
                 core algorithm. -->
            <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
            <ResolveAmbiguousFace ambiguous_face="{face1}" second_face="{face2}" resolved_theta_deg="{theta}"/>
            <!-- Release-safety fix (replaces the old per-case
                 CheckClosingAxisVertical + conditional-sign correction,
                 which could not work: a boolean "is it vertical" throws
                 away which of the two physically different bad
                 configurations we're in, so no single fixed sign can
                 correct both -- confirmed by direct regression testing
                 (a sign that fixed face1=5 broke face1=1). Root-cause fix
                 instead of a bigger lookup table: never try to correct
                 the tip pose at all. Always undo the EXACT tip rotation
                 (same fixed axis, opposite angle) before releasing. This
                 unconditionally returns the gripper to {pick_orientation}
                 -- the SAME pose it just picked from a moment ago, so by
                 construction it is reachable and non-vertical (that pose
                 is the standard GetGraspOrientation grasp used everywhere
                 else in this project). No per-face/per-theta case
                 analysis needed: the undo is the same fixed move
                 regardless of face1, face2 or theta. -->
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="0.0;0.0;0.0" orientation="0.0;-0.7071067811865476;0.0;0.7071067811865476"/>
            </RetryUntilSuccessful>
            <!-- Descend to rest the die before releasing.
                 cartesian_motion=false: same Cartesian-interpolation
                 failure class as the tip move -- from a tipped wrist
                 configuration even a small pure-Z move can fail straight-
                 line interpolation (observed directly, instant
                 ACTION_ABORTED/99999, not a real reachability limit). -->
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="0.0;0.0;-0.10" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
        </Sequence>
    </BehaviorTree>
</root>

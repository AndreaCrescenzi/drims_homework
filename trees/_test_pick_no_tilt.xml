<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    Diagnostic-only spike: pick-only preview (no gripper close, no
    attach, no rotation) with tilt_deg forced to 0.0, to test whether
    the tilted approach is what pushes an edge-of-workspace pick pose
    out of reach (observed: 2->4 pick at (0.8, 0.35) failed with
    NO_IK_SOLUTION using the default auto-tilt).
    -->
    <BehaviorTree ID="MainTree">
        <Sequence>
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <GetFaceRotation current_face="{face}" target_face="4" orientation="{rel_quat}" ref_frame="{ref_frame}"/>
            <GetGraspOrientation current_face="{face}" target_face="4" rotation_quat="{rel_quat}" tilt_deg="0.0" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
        </Sequence>
    </BehaviorTree>
</root>

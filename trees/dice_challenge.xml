<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    ReorientCycle: one full pick -> rotate -> place cycle, bringing
    whichever face is currently up to `target`. Reused once for an
    adjacent-face target, or twice (via an intermediate face) for an
    opposite-face target -- see MainTree below.

    Deliberately a SINGLE deterministic path, no escalation/fallback
    chains: earlier versions tried several alternate grasp strategies
    (flip_grasp, multiple tilt signs, height escalation, a detour via a
    third face, joint-space retries) whenever something failed. That
    grew hard to reason about and, since a wrong-but-"successful" grasp
    (e.g. a finger physically resting on the target face) doesn't
    register as a failure at all, the escalation logic couldn't even
    detect every case it needed to. Back to one clear path per move,
    fixed by understanding *why* each step works rather than by trying
    alternatives until one does; RetryUntilSuccessful is kept where a
    move can transiently fail for reasons unrelated to reachability
    (motion_server's IK-timeout bug -- see TESTING.md/project memory),
    since retrying the identical move there is the correct fix, not an
    alternate strategy.

    Grasp: tilt_deg defaults to a geometry-derived sign (see
    GetGraspOrientation) rather than a plain vertical approach -- besides
    being the direction verified to reliably clear the post-pick
    rotation, tilting lets the final placement bring the die closer to
    the table before releasing than a purely vertical approach would.
    -->
    <BehaviorTree ID="ReorientCycle">
        <Sequence>
            <!-- Defensive release: if a PREVIOUS run was interrupted
                 mid-cycle, the die can be left attached with the gripper
                 closed. Detach/open here first, wherever the arm
                 currently is, so the die settles back to the table
                 before we read its face; ignore DetachObject failure
                 (Fallback + AlwaysSuccess -- this is error suppression
                 for an expected no-op, not a strategy alternative) since
                 on the normal path nothing is attached yet. -->
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <!-- GetFaceRotation before the pick: it only needs
                 current_face/target_face via TF lookups on the die's own
                 face{N}_tf frames, not the robot having touched the die.
                 Lets GetGraspOrientation pick a tilt sign that agrees
                 with the upcoming rotation (see that class's comment),
                 and the same rel_quat/ref_frame get reused for the
                 rotate move further down instead of looking it up twice. -->
            <GetFaceRotation current_face="{face}" target_face="{target}" orientation="{rel_quat}" ref_frame="{ref_frame}"/>
            <GetGraspOrientation current_face="{face}" target_face="{target}" rotation_quat="{rel_quat}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
            </RetryUntilSuccessful>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
            <AttachObject service_name="/attach_object" object_id="dice" target_frame_id="tool0"/>
            <!-- Relocate to the safe zone (away from the cell's
                 camera-mount crossbar -- real collision geometry in the
                 SRDF, not just visual, confirmed empirically to block
                 rotations that pass under it regardless of lift height)
                 BEFORE rotating, not just at the end: the die can spawn
                 anywhere in the challenge's allowed area, including
                 right under the bar. Same (0.55, 0.1) as the final
                 placement target below, by design -- rotating in place
                 only drifts the die a few cm, so the post-rotation
                 correction only has that small drift plus the release
                 descent left to do. z_offset=0.10 lifts by that fixed
                 clearance while translating (a straight-line 3D move,
                 no orientation change, so combining lift+translate is
                 safe -- unlike lift+ROTATE, which fails to find a
                 straight-line path for large reorientations, why those
                 stay separate below). 0.10m is also already enough
                 clearance for the rotation itself, so no separate
                 baseline lift is needed before rotating. -->
            <ComputeXYCorrection current_pose="{dice_pose}" target_x="0.55" target_y="0.1" z_offset="0.07" xy_correction="{xy_corr_pre}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_pre}" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="{ref_frame}" position="0.0;0.0;0.0" orientation="{rel_quat}"/>
            </RetryUntilSuccessful>
            <!-- skip_placement (required on every caller, see MainTree):
                 true for the INTERMEDIATE hop of a two-cycle (opposite-
                 face) rotation only. That hop's precise final XY doesn't
                 matter -- the second cycle re-identifies and re-picks the
                 die from wherever it landed regardless -- but it still
                 has to be RESTED on the table, not dropped from the
                 relocation height: releasing while still elevated risks
                 a bounce/tip that loses the just-achieved orientation
                 before the second cycle ever gets to read it. Descends
                 in two separate simple moves (XY first while elevated,
                 then Z-only down to the table) rather than one combined
                 move -- the same reasoning as the real placement branch
                 below, just split further: a single move correcting
                 XY *and* a large Z all at once is more likely to run out
                 of reachable configurations along the straight-line path
                 than two smaller, single-purpose moves are individually
                 (observed directly: 3->5's combined placement failed at
                 (0.45, 0.1) and only needed moving to a clearer spot to
                 succeed there -- splitting the move similarly gives it
                 an easier path). The Precondition reports FAILURE
                 outright (without trying its child) when skip_placement
                 is false, so the outer Fallback moves on to the full
                 placement branch; this Fallback is a required branch
                 dispatch, not a retry-on-failure escalation. -->
            <Fallback>
                <Precondition if="skip_placement == 'true'" else="FAILURE">
                    <Sequence>
                        <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
                        <ComputeXYCorrection current_pose="{dice_pose2}" target_x="0.55" target_y="0.1" xy_correction="{xy_corr_mid_xy}"/>
                        <RetryUntilSuccessful num_attempts="2">
                            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_mid_xy}" orientation="0.0;0.0;0.0;1.0"/>
                        </RetryUntilSuccessful>
                        <DiceIdentification service_name="/dice_identification" face_number="{face2b}" pose="{dice_pose2b}"/>
                        <ComputeXYCorrection current_pose="{dice_pose2b}" target_x="0.55" target_y="0.1" target_z="0.027" xy_correction="{xy_corr_mid_z}"/>
                        <RetryUntilSuccessful num_attempts="2">
                            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_mid_z}" orientation="0.0;0.0;0.0;1.0"/>
                        </RetryUntilSuccessful>
                        <Fallback>
                            <DetachObject service_name="/detach_object" object_id="dice"/>
                            <AlwaysSuccess/>
                        </Fallback>
                        <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                    </Sequence>
                </Precondition>
                <Sequence>
                    <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
                    <!-- (0.55, 0.1): the cell's camera bar's shadow
                         covers a wider stretch of the table than a
                         single point -- confirmed empirically that
                         x=0.6 fails even at y=-0.15, while (0.55, 0.1)
                         is clear and reachable directly, and more
                         reliably reachable for the final placement move
                         than the originally-tried (0.45, 0.1) (observed
                         failing there from some post-rotation wrist
                         configurations, e.g. 3->5).
                         target_z=0.027 (base_link) is the die's own
                         measured resting height (TF: base_link ->
                         dice_tf when sitting flat on the table) --
                         correcting straight to this known value in the
                         SAME move as the XY correction lands the die
                         close to the table on release instead of
                         dropping it from wherever the rotation left it. -->
                    <ComputeXYCorrection current_pose="{dice_pose2}" target_x="0.55" target_y="0.1" target_z="0.027" xy_correction="{xy_corr}"/>
                    <RetryUntilSuccessful num_attempts="2">
                        <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr}" orientation="0.0;0.0;0.0;1.0"/>
                    </RetryUntilSuccessful>
                    <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                    <DetachObject service_name="/detach_object" object_id="dice"/>
                </Sequence>
            </Fallback>
        </Sequence>
    </BehaviorTree>

    <!--
    MainTree: the real challenge entry point. Edit target_face below (the
    one and only place it needs to be set) to change which face the die
    should end up showing.
    -->
    <BehaviorTree ID="MainTree">
        <Sequence>
            <Script code="target_face:=6" />  <!-- STRESS_TEST_TARGET -->
            <!-- Same defensive release ReorientCycle does at its own
                 start, but here at the MainTree entry point too: if
                 num_steps ends up 0 (die already showing target_face),
                 ReorientCycle is never called at all, so its own
                 defensive detach/open would never run -- silently
                 reporting success while a die left attached/mid-air from
                 a previous interrupted run gets read as if it were
                 genuinely resting and showing that face. -->
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <PlanRotationPath current_face="{face}" target_face="{target_face}" num_steps="{num_steps}" intermediate_face="{intermediate}" detour_face="{detour}"/>
            <Fallback>
                <Precondition if="num_steps==0" else="FAILURE">
                    <AlwaysSuccess/>
                </Precondition>
                <Precondition if="num_steps==1" else="FAILURE">
                    <SubTree ID="ReorientCycle" target="{target_face}" skip_placement="false"/>
                </Precondition>
                <Precondition if="num_steps==2" else="FAILURE">
                    <Sequence>
                        <SubTree ID="ReorientCycle" target="{intermediate}" skip_placement="true"/>
                        <SubTree ID="ReorientCycle" target="{target_face}" skip_placement="false"/>
                    </Sequence>
                </Precondition>
            </Fallback>
            <!-- Return home once, here at the very end of the whole
                 mission -- not inside ReorientCycle, which would also
                 run this between the two hops of an opposite-face
                 (num_steps==2) rotation, homing needlessly in the
                 middle of a single logical mission. -->
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
        </Sequence>
    </BehaviorTree>
</root>

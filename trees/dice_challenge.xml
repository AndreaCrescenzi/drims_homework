<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!-- DRIMS2 dice challenge.
        Phase 1: pick blind, carry to a fixed joint configuration, tip 90deg,
        put down, read the second face at rest -> the resting yaw follows from
        the two pip counts and the rotation measured on the gripper.
        Phase 2: PlanRotationPath decides 0, 1 or 2 reorientation cycles.
        Non-obvious dependencies: AllowAttachedContact after every grasp, the
        fixed carry pose before the tip, and no in-air rotation except the tip. -->
    <BehaviorTree ID="ReorientCycle">
        <Sequence>
            <!-- Defensive release: a previous interrupted run can leave the die attached. -->
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <!-- Gripper failures never stop the tree: the effort field is an int in the
                             adapter, so a valid command can be reported as failed. -->
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.043" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <!-- Before the pick: only needs the face frames, not the grasp. -->
            <GetFaceRotation current_face="{face}" target_face="{target}" orientation="{rel_quat}" ref_frame="{ref_frame}"/>
            <GetGraspOrientation current_face="{face}" target_face="{target}" rotation_quat="{rel_quat}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" cartesian_motion="true" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
            </RetryUntilSuccessful>
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <AttachObject service_name="/attach_object" object_id="dice" target_frame_id="tool0"/>
            <!-- Their /attach_object leaves touch_links=["tool0"]: without this MoveIt
                             reads the grasp itself as a collision and every IK fails as -31. -->
            <AllowAttachedContact object_id="dice"/>
            <!-- Move to the safe zone before rotating. -->
            <ComputeXYCorrection current_pose="{dice_pose}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" z_offset="0.035" xy_correction="{xy_corr_pre}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_pre}" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="{ref_frame}" position="0.0;0.0;0.0" orientation="{rel_quat}"/>
            </RetryUntilSuccessful>
            <!-- skip_placement: skip the final release on the first hop of a two-hop
                             rotation, so the die is not put down just to be picked up again. -->
            <Fallback>
                <Precondition if="skip_placement == 'true'" else="FAILURE">
                    <Sequence>
                        <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
                        <ComputeXYCorrection current_pose="{dice_pose2}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" xy_correction="{xy_corr_mid_xy}"/>
                        <RetryUntilSuccessful num_attempts="2">
                            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_mid_xy}" orientation="0.0;0.0;0.0;1.0"/>
                        </RetryUntilSuccessful>
                        <DiceIdentification service_name="/dice_identification" face_number="{face2b}" pose="{dice_pose2b}"/>
                        <ComputeXYCorrection current_pose="{dice_pose2b}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" target_z="0.012" xy_correction="{xy_corr_mid_z}"/>
                        <RetryUntilSuccessful num_attempts="2">
                            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_mid_z}" orientation="0.0;0.0;0.0;1.0"/>
                        </RetryUntilSuccessful>
                        <Fallback>
                            <DetachObject service_name="/detach_object" object_id="dice"/>
                            <AlwaysSuccess/>
                        </Fallback>
                        <Fallback>
                            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                            <AlwaysSuccess/>
                        </Fallback>
                    </Sequence>
                </Precondition>
                <Sequence>
                    <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
                    <!-- Targets are given in camera_frame_floor (the play field), so they stay
                                     valid if the cell or the robot mounting changes. -->
                    <!-- Same target as above, plus the release height. -->
                    <ComputeXYCorrection current_pose="{dice_pose2}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" target_z="0.012" xy_correction="{xy_corr}"/>
                    <!-- Joint space: the straight-line planner cannot solve this one. -->
                    <RetryUntilSuccessful num_attempts="2">
                        <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="{xy_corr}" orientation="0.0;0.0;0.0;1.0"/>
                    </RetryUntilSuccessful>
                    <Fallback>
                        <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                        <AlwaysSuccess/>
                    </Fallback>
                    <DetachObject service_name="/detach_object" object_id="dice"/>
                </Sequence>
            </Fallback>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="MainTree">
        <Sequence>
            <!-- Target face for this run. -->
            <Script code="target_face:=6"/>


            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.043" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <RetryUntilSuccessful num_attempts="3">
                <MoveToJoint action_name="/move_to_joint" joint_target="1.5708;-1.97;2.13;-1.83;-1.50;0.0"/>
            </RetryUntilSuccessful>

            <!-- Blind pick: only the face number is trusted at this point. -->
            <DiceIdentification service_name="/dice_identification" face_number="{face1}" pose="{dice_pose1}"/>
            <!-- The closing axis must end up parallel to the tip axis or the exposed
                             face is one the fingers hold (measured: 0/24 vs 24/24 occluded). -->
            <!-- tilt_deg=0: vertical approach, reaches the corners where the tilted one
                             returns NO_IK_SOLUTION. Safe because the carry pose below
                             decouples the grasp from everything downstream. -->
            <!-- From the blackboard: patch_tree strips every literal tilt_deg="...". -->
            <SetBlackboard output_key="phase1_tilt" value="0.0"/>
            <GetGraspOrientation current_face="{face1}" target_face="{face1}" tilt_deg="{phase1_tilt}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
            </RetryUntilSuccessful>
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <AttachObject service_name="/attach_object" object_id="dice" target_frame_id="tool0"/>
            <!-- Their /attach_object leaves touch_links=["tool0"]: without this MoveIt
                             reads the grasp itself as a collision and every IK fails as -31. -->
            <AllowAttachedContact object_id="dice"/>
            <!-- Snapshot: what follows is measured against this, not assumed. -->
            <CaptureFrameRotation parent_frame="world" child_frame="tool0" orientation="{q_grasp}"/>

            <!-- Fixed carry configuration. The same Cartesian pose is reachable in
                             several joint configurations and only some leave room for the
                             tip; pinning it removes the randomness. MoveToJoint is also the
                             only motion that never calls compute_ik. -->
            <RetryUntilSuccessful num_attempts="3">
                <MoveToJoint action_name="/move_to_joint" joint_target="1.098;-1.748;2.340;-1.735;-0.887;0.943"/>
            </RetryUntilSuccessful>

            <!-- One 90deg turn about the world axis parallel to the closing axis. -->
            <SelectTipAxis world_frame="world" gripper_frame="tool0" prefer_negative="true" tip_axis="{tip_axis}" alignment="{tip_alignment}"/>
            <GetTipRotation tip_axis="{tip_axis}" orientation="{tip_quat}" inverse_orientation="{tip_quat_inv}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="world" position="0.0;0.0;0.0" orientation="{tip_quat}"/>
            </RetryUntilSuccessful>

            <!-- Second snapshot: q_total is the true rotation applied to the die. -->
            <CaptureFrameRotation parent_frame="world" child_frame="tool0" orientation="{q_tipped}"/>
            <ComputeRelativeRotation from="{q_grasp}" to="{q_tipped}" delta="{q_total}" inverse_delta="{q_total_inv}" angle_deg="{total_deg}"/>

            <!-- Measures occlusion only, never blocks. -->
            <Fallback>
                <CheckClosingAxisVertical base_frame="base_link" gripper_frame="tool0" threshold="0.7" is_vertical="{pinch_vertical}"/>
                <AlwaysSuccess/>
            </Fallback>

            <!-- Resolved analytically from the measured rotation, not from a per-axis
                             table (verified: reproduces both derived tables exactly). -->

            <!-- Nothing else is rotated in the air: every extra in-air rotation is
                             another collision-checked query that can fail, and none is needed. -->

            <!-- Re-read first: the rotation shifts the die a few cm, the pivot is not
                             its centre. -->
            <DiceIdentification service_name="/dice_identification" face_number="{face_mid}" pose="{dice_pose_mid}"/>
            <ComputeXYCorrection current_pose="{dice_pose_mid}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" target_z="0.012" xy_correction="{centre_place}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="{centre_place}" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>

            <!-- Straight retreat before anything else moves. -->
            <RetryUntilSuccessful num_attempts="2">
                <!-- Joint target: with the die detached and the fingers still around it,
                                 any collision-checked IK fails. -->
                <MoveToJoint action_name="/move_to_joint" joint_target="1.5708;-1.97;2.13;-1.83;-1.50;0.0"/>
            </RetryUntilSuccessful>

            <!-- Verification read. -->
            <DiceIdentification service_name="/dice_identification" face_number="{face3}" pose="{dice_pose3}"/>
            <!-- Die at rest and unobstructed: this is the second face reading. -->
            <ResolveDieOrientation current_face="{face1}" second_face="{face3}" total_rotation="{q_total}" resolved_theta_deg="{theta}"/>

            <!-- ===== Phase 2 ===== -->
            <!-- Orientation known: one cycle for an adjacent face, two for the opposite. -->
            <PlanRotationPath current_face="{face3}" target_face="{target_face}" num_steps="{num_steps}" intermediate_face="{intermediate}" detour_face="{detour}"/>
            <Fallback>
                <Precondition if="num_steps==0" else="FAILURE">
                    <AlwaysSuccess/>
                </Precondition>
                <Precondition if="num_steps==1" else="FAILURE">
                    <SubTree ID="ReorientCycle" target="{target_face}" skip_placement="false"/>
                </Precondition>
                <Precondition if="num_steps==2" else="FAILURE">
                    <Sequence>
                        <SubTree ID="ReorientCycle" target="{intermediate}" skip_placement="true"/>
                        <SubTree ID="ReorientCycle" target="{target_face}" skip_placement="false"/>
                    </Sequence>
                </Precondition>
            </Fallback>

            <!-- Cartesian: a joint-space home lets the planner swing the whole arm. -->
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" cartesian_motion="true" frame_id="base_link" position="-0.140;0.331;0.403" orientation="0.998;0.001;-0.035;-0.050"/>
            </RetryUntilSuccessful>
        </Sequence>
    </BehaviorTree>
</root>

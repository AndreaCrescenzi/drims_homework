<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    Full mission on top of real-vision assumptions: phase 1 (identify +
    normalize) followed by the EXISTING ReorientCycle, copied from
    dice_challenge.xml with only the placement targets repointed at the
    camera frame's floor plate.

    Phase 1 leaves the die resting canonically (yaw 0) at the plate centre,
    which is exactly the precondition ReorientCycle's grasp table assumes.
    Measured: with a blind pick that assumption holds only half the time
    (60/120 combinations close on a different face pair than the table
    expects, 48/120 put a finger on the target face); after a canonical
    placement, 0/30. So phase 2 needs no changes at all.

    KNOWN GAP for the real robot: ReorientCycle computes its rotation with
    GetFaceRotation, which looks up the simulator-only face{N}_tf frames.
    Those do not exist on the real cell, so phase 2 as it stands is
    simulation-only. Phase 1, by contrast, is fully analytic and needs no
    such frames. Replacing GetFaceRotation with an analytic equivalent is
    the remaining piece -- the maths is already worked out (it needs
    current_face, the resolved yaw and target_face, all of which phase 1
    now provides).
    -->

    <BehaviorTree ID="ReorientCycle">
        <Sequence>
            <!-- Defensive release: if a PREVIOUS run was interrupted
                 mid-cycle, the die can be left attached with the gripper
                 closed. Detach/open here first, wherever the arm
                 currently is, so the die settles back to the table
                 before we read its face; ignore DetachObject failure
                 (Fallback + AlwaysSuccess -- this is error suppression
                 for an expected no-op, not a strategy alternative) since
                 on the normal path nothing is attached yet.
                 position=0.043 (not the "real" open value 0.045 used
                 elsewhere below): on the real robot,
                 robotiq_2f_adapter_node.py (organizers' code in
                 ~/static/drims2_ws, not ours -- not modifying it) throws
                 an exception whenever the requested position is EXACTLY
                 equal to the gripper's current one (an int-vs-float bug
                 in its own "already there" success branch). This
                 defensive open is exactly the highest-risk case for that:
                 called right after MainTree's own identical defensive
                 open moments earlier (nothing in between touches the
                 gripper), so requesting the SAME 0.045 here is guaranteed
                 to collide with it.
                 IMPORTANT: the adapter compares NORMALIZED positions (an
                 int 0-255, not raw meters) -- verified from the gripper's
                 own autocalibrated range (~0.00176m to ~0.04941m over 255
                 steps, ~0.187mm/step). A first attempt using 0.0449 (only
                 0.1mm off, less than one step) still collided, since it
                 normalized to the SAME integer as 0.045 -- confirmed by
                 the bug still firing. 0.043 (2mm off, ~10+ steps) is
                 comfortably larger than the step size, guaranteeing a
                 different normalized value, while still well within the
                 die's grasp tolerance -- mechanically indistinguishable
                 from a full open. Worked around entirely on our side,
                 without touching their file. -->
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <!-- Fallback + AlwaysSuccess: don't let a GripperCommand
                 failure (e.g. the real robot's effort/float bug, or any
                 other transient gripper fault) abort the whole Sequence
                 -- same error-suppression idiom already used for
                 DetachObject above. Trade-off accepted deliberately: we
                 don't verify the gripper actually reached this position
                 before moving on. -->
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.043" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <!-- GetFaceRotation before the pick: it only needs
                 current_face/target_face via TF lookups on the die's own
                 face{N}_tf frames, not the robot having touched the die.
                 Lets GetGraspOrientation pick a tilt sign that agrees
                 with the upcoming rotation (see that class's comment),
                 and the same rel_quat/ref_frame get reused for the
                 rotate move further down instead of looking it up twice. -->
            <GetFaceRotation current_face="{face}" target_face="{target}" orientation="{rel_quat}" ref_frame="{ref_frame}"/>
            <GetGraspOrientation current_face="{face}" target_face="{target}" rotation_quat="{rel_quat}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
            </RetryUntilSuccessful>
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <AttachObject service_name="/attach_object" object_id="dice" target_frame_id="tool0"/>
            <!-- Relocate to the safe zone (away from the cell's
                 camera-mount crossbar -- real collision geometry in the
                 SRDF, not just visual, confirmed empirically to block
                 rotations that pass under it regardless of lift height)
                 BEFORE rotating, not just at the end: the die can spawn
                 anywhere in the challenge's allowed area, including
                 right under the bar. Same (0.55, 0.1) as the final
                 placement target below, by design -- rotating in place
                 only drifts the die a few cm, so the post-rotation
                 correction only has that small drift plus the release
                 descent left to do. z_offset=0.10 lifts by that fixed
                 clearance while translating (a straight-line 3D move,
                 no orientation change, so combining lift+translate is
                 safe -- unlike lift+ROTATE, which fails to find a
                 straight-line path for large reorientations, why those
                 stay separate below). 0.10m is also already enough
                 clearance for the rotation itself, so no separate
                 baseline lift is needed before rotating. -->
            <ComputeXYCorrection current_pose="{dice_pose}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" z_offset="0.035" xy_correction="{xy_corr_pre}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_pre}" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="{ref_frame}" position="0.0;0.0;0.0" orientation="{rel_quat}"/>
            </RetryUntilSuccessful>
            <!-- skip_placement (required on every caller, see MainTree):
                 true for the INTERMEDIATE hop of a two-cycle (opposite-
                 face) rotation only. That hop's precise final XY doesn't
                 matter -- the second cycle re-identifies and re-picks the
                 die from wherever it landed regardless -- but it still
                 has to be RESTED on the table, not dropped from the
                 relocation height: releasing while still elevated risks
                 a bounce/tip that loses the just-achieved orientation
                 before the second cycle ever gets to read it. Descends
                 in two separate simple moves (XY first while elevated,
                 then Z-only down to the table) rather than one combined
                 move -- the same reasoning as the real placement branch
                 below, just split further: a single move correcting
                 XY *and* a large Z all at once is more likely to run out
                 of reachable configurations along the straight-line path
                 than two smaller, single-purpose moves are individually
                 (observed directly: 3->5's combined placement failed at
                 (0.45, 0.1) and only needed moving to a clearer spot to
                 succeed there -- splitting the move similarly gives it
                 an easier path). The Precondition reports FAILURE
                 outright (without trying its child) when skip_placement
                 is false, so the outer Fallback moves on to the full
                 placement branch; this Fallback is a required branch
                 dispatch, not a retry-on-failure escalation. -->
            <Fallback>
                <Precondition if="skip_placement == 'true'" else="FAILURE">
                    <Sequence>
                        <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
                        <ComputeXYCorrection current_pose="{dice_pose2}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" xy_correction="{xy_corr_mid_xy}"/>
                        <RetryUntilSuccessful num_attempts="2">
                            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_mid_xy}" orientation="0.0;0.0;0.0;1.0"/>
                        </RetryUntilSuccessful>
                        <DiceIdentification service_name="/dice_identification" face_number="{face2b}" pose="{dice_pose2b}"/>
                        <ComputeXYCorrection current_pose="{dice_pose2b}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" target_z="-0.03" xy_correction="{xy_corr_mid_z}"/>
                        <RetryUntilSuccessful num_attempts="2">
                            <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{xy_corr_mid_z}" orientation="0.0;0.0;0.0;1.0"/>
                        </RetryUntilSuccessful>
                        <Fallback>
                            <DetachObject service_name="/detach_object" object_id="dice"/>
                            <AlwaysSuccess/>
                        </Fallback>
                        <Fallback>
                            <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                            <AlwaysSuccess/>
                        </Fallback>
                    </Sequence>
                </Precondition>
                <Sequence>
                    <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
                    <!-- target_frame="camera_frame_floor": place_x/y/z
                         (from dice_mission.launch.py) are now interpreted
                         in this frame, not base_link -- it hangs off
                         "table_top" in the URDF (verified in
                         ur5e_cell.urdf.xacro), so the safe-zone target
                         stays physically correct even if a cell's
                         base_link mounting angle changes, unlike a raw
                         base_link number would. The specific reachability
                         findings from the old base_link-tuned values
                         (clear of the camera bar's shadow, etc.) don't
                         carry over as numbers -- re-verify on RViz when
                         picking a new camera_frame_floor point, same as
                         before. target_z is still an absolute height, now
                         measured in camera_frame_floor rather than
                         base_link (the die's known resting height there
                         needs re-deriving, not reused from the old
                         base_link value). -->
                    <!-- Same target as the pre-rotation relocation above,
                         by design -- rotating in place only drifts the
                         die a few cm, so this final correction only has
                         to cover that small drift plus the release
                         descent. -->
                    <ComputeXYCorrection current_pose="{dice_pose2}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" target_z="-0.01" xy_correction="{xy_corr}"/>
                    <!-- cartesian_motion=false, unlike dice_challenge.xml:
                         this move corrects XY *and* a large Z at once,
                         starting from the wrist configuration the 90deg
                         rotation just left behind. As a straight line it
                         fails instantly with 99999 (observed) -- the same
                         combined-move limit this tree's own comments
                         describe. The descent got ~6cm longer once the die
                         was placed at its true resting height on the plate
                         instead of floating, which is what pushed it over.
                         Joint-space planning handles it. -->
                    <RetryUntilSuccessful num_attempts="2">
                        <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="false" frame_id="base_link" position="{xy_corr}" orientation="0.0;0.0;0.0;1.0"/>
                    </RetryUntilSuccessful>
                    <Fallback>
                        <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                        <AlwaysSuccess/>
                    </Fallback>
                    <DetachObject service_name="/detach_object" object_id="dice"/>
                </Sequence>
            </Fallback>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="MainTree">
        <Sequence>
            <!-- Target face for this run. -->
            <Script code="target_face:=6"/>


            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.043" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <MoveToJoint action_name="/move_to_joint" joint_target="1.5708;-1.97;2.13;-1.83;-1.50;0.0"/>

            <!-- Blind pick: only the face number is trusted here. The
                 degenerate target_face==current_face call just asks for the
                 standard tilted grasp; which pair it ends up pinching is
                 unknown at this point, and deliberately not relied upon. -->
            <DiceIdentification service_name="/dice_identification" face_number="{face1}" pose="{dice_pose1}"/>
            <!-- The tip axis is declared here because the GRASP depends on
                 it too: the closing axis must be parallel to the tip axis,
                 otherwise the tip drives it vertical and the face it
                 exposes is one the fingers are holding. Measured over all 6
                 faces x 4 yaw hypotheses: parallel -> 0/24 occluded,
                 perpendicular -> 24/24. Both stay fully informative. -->
            <GetGraspOrientation current_face="{face1}" target_face="{face1}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
            </RetryUntilSuccessful>
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.0" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <AttachObject service_name="/attach_object" object_id="dice" target_frame_id="tool0"/>

            <!-- Lift AND centre over the play area in one straight-line
                 move (safe to combine: translation only, no reorientation).
                 The target is the centre of the camera frame's floor plate
                 -- on the real cell the camera is mounted above that
                 structure and looks down at it, so it IS the field the die
                 is thrown onto and read in. (0.365, 0.265) is the plate's
                 centre in camera_frame_floor: the plate is a 0.63 x 0.43
                 box whose visual origin sits at (frame_x/2, frame_y/2) with
                 frame_x=0.73, frame_y=0.53, beam=0.05 in
                 ur5e_cell.urdf.xacro. Expressing it in that frame rather
                 than as tuned base_link numbers keeps it correct if the
                 cell or the robot's mounting angle changes.
                 NOTE for simulation: in configuration_cell_1.yaml the
                 camera (child of base_link, at 0.6/0/0.8) and this plate
                 (child of table_top) are placed independently and do NOT
                 line up -- the camera looks at base_link (0.600, 0.000)
                 while the plate centre is at (-0.095, 0.685). That is a
                 cell-config inconsistency, harmless in sim (identification
                 is a cheat service that reads TF, not the camera) but worth
                 fixing before trusting the sim's camera view. -->
            <ComputeXYCorrection current_pose="{dice_pose1}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" z_offset="0.035" xy_correction="{centre_lift}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{centre_lift}" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>

            <!-- The informative tip: 90deg about a fixed WORLD axis. The
                 axis is named ONCE here and drives both the quaternion
                 actually commanded (GetTipRotation) and the table used to
                 resolve it (ResolveDieOrientation), so the two can't drift
                 apart into a wrong-but-plausible yaw. All four candidate
                 axes are equally valid (each injective, verified
                 numerically); which one the wrist can reach depends on the
                 cell, home pose and die position -- world_Y+ was validated
                 earlier but became NO_IK_SOLUTION after the home pose moved
                 to shoulder_pan=90deg and the spawn position changed, so
                 world_X+ is used here. cartesian_motion=false: a 90deg
                 reorientation doesn't survive straight-line interpolation.

                 frame_id="world", NOT "base_link": this cell's base_link is
                 rotated -90deg about Z relative to world (robot.rpy in
                 configuration_cell_N.yaml), measured directly via TF. The
                 older comments in this project claiming the two share an
                 orientation are wrong. It matters here because the tables
                 are derived in the frame where the face normals and "up"
                 live (world, which is what /dice_identification reports
                 in): commanding the same quaternion in base_link executed a
                 world_Y- tip instead of world_X+, so the resolver read the
                 wrong table and produced a yaw ~100deg off. Confirmed by
                 cross-check: the face the robot actually read matches the
                 world_Y- table exactly. -->
            <!-- The tip axis is chosen from the closing axis the grasp
                 actually produced (measured via TF), not fixed in advance:
                 the tip must be PARALLEL to the closing axis, otherwise it
                 drives that axis vertical and the face it exposes is one
                 the fingers are holding. Measured over all 6 faces x 4 yaw
                 hypotheses: parallel -> 0/24 occluded, perpendicular ->
                 24/24, both equally informative. Choosing the axis to match
                 the grasp (rather than forcing the grasp to match a chosen
                 axis) keeps the existing, kinematically-proven pick
                 untouched. -->
            <SelectTipAxis world_frame="world" gripper_frame="tool0" prefer_negative="false" tip_axis="{tip_axis}" alignment="{tip_alignment}"/>
            <GetTipRotation tip_axis="{tip_axis}" orientation="{tip_quat}" inverse_orientation="{tip_quat_inv}" half_orientation="{tip_half}" half_inverse_orientation="{tip_half_inv}"/>
            <!-- Two Cartesian 45deg steps rather than one joint-space
                 90deg: the grasp point stays put and the wrist turns in
                 place, instead of the sampling planner swinging the whole
                 arm around to reach the same orientation. Same result,
                 much smaller and safer motion. -->
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="world" position="0.0;0.0;0.0" orientation="{tip_half}"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="world" position="0.0;0.0;0.0" orientation="{tip_half}"/>
            </RetryUntilSuccessful>
            <!-- Evidence that the exposed face is actually readable: with
                 the closing axis parallel to the tip axis it should stay
                 horizontal (|z| ~ 0), meaning the fingers hold two side
                 faces and not the one now facing the camera. Wrapped so it
                 only measures and logs, never blocks. -->
            <Fallback>
                <CheckClosingAxisVertical base_frame="base_link" gripper_frame="tool0" threshold="0.7" is_vertical="{pinch_vertical}"/>
                <AlwaysSuccess/>
            </Fallback>
            <DiceIdentification service_name="/dice_identification" face_number="{face2}" pose="{dice_pose2}"/>
            <ResolveDieOrientation current_face="{face1}" second_face="{face2}" tip_axis="{tip_axis}" resolved_theta_deg="{theta}"/>

            <!-- Undo the tip before placing. Rotating straight out of the
                 tipped pose to the canonical placement was observed to hit
                 NO_IK_SOLUTION; undoing first is reachable by construction
                 (it returns the wrist to the pose it was in a moment ago)
                 and leaves the placement rotation starting from the known-
                 good pick configuration. Same lesson as elsewhere in this
                 project: two smaller moves beat one large one. -->
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="world" position="0.0;0.0;0.0" orientation="{tip_half_inv}"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="world" position="0.0;0.0;0.0" orientation="{tip_half_inv}"/>
            </RetryUntilSuccessful>

            <!-- Rotate to a canonical (yaw = 0) placement, chosen so the
                 closing axis stays horizontal at release. Verified: such a
                 placement exists for every (face, yaw), always with the
                 closing axis exactly horizontal; rotations are 90 or 120deg.
                 tip_orientation is identity here: the tip has just been
                 undone, so no net rotation has been applied since the pick. -->
            <ComputeCanonicalPlacement current_face="{face1}" resolved_theta_deg="{theta}" pick_orientation="{pick_orientation}" tip_orientation="0.0;0.0;0.0;1.0" orientation="{canonical_rot}" half_orientation="{canonical_half}" placed_face="{placed_face}"/>
            <!-- Two Cartesian half-steps, same reasoning as the tip: the
                 wrist turns in place instead of the arm swinging around. -->
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="world" position="0.0;0.0;0.0" orientation="{canonical_half}"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="world" position="0.0;0.0;0.0" orientation="{canonical_half}"/>
            </RetryUntilSuccessful>

            <!-- Place back down centred under the camera. Re-reads the pose
                 first because the canonical rotation shifts the die a few
                 cm (the rotation pivot isn't the die's centre), then
                 corrects XY back to the plate centre and Z down to the
                 die's resting height on the PLATE -- the camera frame's
                 floor plate is the surface the die actually sits on, not
                 the table: measured base_link z -0.050 for the plate, +5mm
                 thickness, +15mm half a die = -0.030 -- in one
                 move -- same pattern ReorientCycle already uses. -->
            <DiceIdentification service_name="/dice_identification" face_number="{face_mid}" pose="{dice_pose_mid}"/>
            <ComputeXYCorrection current_pose="{dice_pose_mid}" target_frame="camera_frame_floor" target_x="0.365" target_y="0.265" target_z="-0.03" xy_correction="{centre_place}"/>
            <RetryUntilSuccessful num_attempts="2">
                <MoveToPose action_name="/move_to_pose" relative_motion="true" cartesian_motion="true" frame_id="base_link" position="{centre_place}" orientation="0.0;0.0;0.0;1.0"/>
            </RetryUntilSuccessful>
            <Fallback>
                <GripperCommand action_name="/gripper_action_controller/gripper_cmd" position="0.045" max_effort="1.0"/>
                <AlwaysSuccess/>
            </Fallback>
            <Fallback>
                <DetachObject service_name="/detach_object" object_id="dice"/>
                <AlwaysSuccess/>
            </Fallback>

            <!-- Verification read: the face now up must equal placed_face.
                 Logged by bt_executor_node so a run can be checked at a
                 glance. -->
            <DiceIdentification service_name="/dice_identification" face_number="{face3}" pose="{dice_pose3}"/>

            <!-- ===== Phase 2: the existing ReorientCycle, unchanged =====
                 It re-identifies the die itself as its first step, so it
                 needs nothing passed in beyond the target. skip_placement
                 is false: this is the final hop, the die must be rested. -->
            <SubTree ID="ReorientCycle" target="{target_face}" skip_placement="false"/>

            <MoveToJoint action_name="/move_to_joint" joint_target="1.5708;-1.97;2.13;-1.83;-1.50;0.0"/>
        </Sequence>
    </BehaviorTree>
</root>

<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!--
    Diagnostic-only spike: tests ONLY the pick approach move (with the
    automatically-derived tilt sign) for a given current->target pair --
    no gripper close, no attach, no rotation. Used to verify the pick
    pose itself is reachable before committing to a full cycle that could
    leave the die in a bad state if something further down fails.
    -->
    <BehaviorTree ID="MainTree">
        <Sequence>
            <MoveToJoint action_name="/move_to_joint" joint_target="0.0;-1.97;2.13;-1.83;-1.50;0.0"/>
            <DiceIdentification service_name="/dice_identification" face_number="{face}" pose="{dice_pose}"/>
            <GetFaceRotation current_face="{face}" target_face="6" orientation="{rel_quat}" ref_frame="{ref_frame}"/>
            <GetGraspOrientation current_face="{face}" target_face="6" rotation_quat="{rel_quat}" pick_orientation="{pick_orientation}" grasp_yaw_deg="{grasp_yaw}"/>
            <MoveToPose action_name="/move_to_pose" cartesian_motion="false" frame_id="dice_tf" position="0.0;0.0;0.0" orientation="{pick_orientation}"/>
        </Sequence>
    </BehaviorTree>
</root>
